AWS_REGION=us-west-2
# bedrock (default) or ollama
FIELDWATCH_PROVIDER=bedrock
# Bedrock model. Haiku 4.5 for dev, Sonnet 4.5 for the demo. Enable both under Bedrock > Model access.
FIELDWATCH_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Only for FIELDWATCH_PROVIDER=ollama
FIELDWATCH_OLLAMA_HOST=http://localhost:11434
FIELDWATCH_OLLAMA_MODEL=qwen3:8b
