# Copy to .env (gitignored). Never commit .env.

# Bedrock API key from the console (Bedrock > API keys). Short-term keys last 12 hours and
# are tied to one region. The key MUST start with "bedrock-api-key-"; paste it whole.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
AWS_REGION=us-east-2

# bedrock (default) or ollama
FIELDWATCH_PROVIDER=bedrock

# Model. Nova Pro works out of the box. Claude models need the account owner to submit the
# one-time Anthropic use-case form in the Bedrock console first (Model catalog > any Claude model).
FIELDWATCH_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FIELDWATCH_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # demo quality
# FIELDWATCH_MODEL=us.amazon.nova-pro-v1:0                         # fallback if Claude is blocked

# Real text messages. Leave all of these empty and the web phone panel is the only copy.
# Twilio (two-way; free trial texts verified numbers only): console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Replies: Twilio is polled every 5s by default (no public URL needed). If you run ngrok, set the
# number's "A message comes in" webhook to https://<ngrok>/sms/inbound and FIELDWATCH_SMS_POLL=0.
# One-way fallbacks: TEXTBELT_KEY=textbelt sends 1 free text/day (textbelt.com), or set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (IAM keys) and FIELDWATCH_SMS=sns.
# FIELDWATCH_SMS=twilio|sns|textbelt|none   (auto-detected from the keys above when unset)

# Only for FIELDWATCH_PROVIDER=ollama
FIELDWATCH_OLLAMA_HOST=http://localhost:11434
FIELDWATCH_OLLAMA_MODEL=qwen3:8b
