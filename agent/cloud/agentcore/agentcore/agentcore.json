{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FieldWatch",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FieldWatch",
    "project": "fieldwatch"
  },
  "runtimes": [
    {
      "name": "fieldwatch_agent",
      "description": "FieldWatch supervisor and specialists (Strands) - agent/app.py",
      "build": "CodeZip",
      "entrypoint": "app.py",
      "codeLocation": "app/fieldwatch_agent/",
      "runtimeVersion": "PYTHON_3_12",
      "envVars": [
        {
          "name": "FIELDWATCH_SSM_BOOTSTRAP",
          "value": "1"
        },
        {
          "name": "FIELDWATCH_PROVIDER",
          "value": "bedrock"
        },
        {
          "name": "FIELDWATCH_MODEL",
          "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "name": "FIELDWATCH_TOOLS_BACKEND",
          "value": "gateway"
        },
        {
          "name": "FIELDWATCH_EVENT_BUS",
          "value": "fieldwatch"
        },
        {
          "name": "FIELDWATCH_TABLE_PREFIX",
          "value": "fw-"
        },
        {
          "name": "FIELDWATCH_APPROVALS_BACKEND",
          "value": "dynamo"
        },
        {
          "name": "FIELDWATCH_DATA_BACKEND",
          "value": "dynamo"
        },
        {
          "name": "FIELDWATCH_SEND_FN",
          "value": "fw-notify-send"
        }
      ],
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "HTTP",
      "additionalPolicies": [
        "policies/runtime-access.json"
      ],
      "tags": {
        "project": "fieldwatch"
      },
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 1800,
        "maxLifetime": 28800
      }
    }
  ],
  "memories": [
    {
      "name": "fieldwatch_memory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        },
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}